# Resend (server only — never prefix with NEXT_PUBLIC_)
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Team inbox that receives contact messages.
# Testing: use your Resend account email, or delivered@resend.dev / bounced@resend.dev
CONTACT_TO_EMAIL=

# Sender. onboarding@resend.dev only delivers to the Resend account owner's email.
# Replace with an address on a verified domain for production.
CONTACT_FROM_EMAIL=onboarding@resend.dev
